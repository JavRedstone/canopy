# PRODUCTION environment. Copy to .env.prod ON THE SERVER and fill in.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Never copy this to .env -- that is the local development file, and the two must not
# converge. `--env-file .env.prod` is required on every compose command; without it
# Compose silently falls back to .env and the prod stack points at local Supabase.
# APP_DEPLOY_TARGET below exists to make that mistake fail loudly instead.
#
# This file is a template and holds no secrets. .env.prod itself does -- it is gitignored
# explicitly (.gitignore lists .env.prod; there is no .env* wildcard) and should exist only
# on the server, never on your laptop.

# Sentinel. Present only here, never in the dev .env, so running the prod compose file
# against the wrong env file aborts instead of quietly starting a misconfigured stack.
APP_DEPLOY_TARGET=production

# --- Public hostnames -------------------------------------------------------------
# The API's own DNS name. Must already resolve to this host before first start, or
# Caddy's certificate challenge fails.
API_DOMAIN=api.replace-with-your-domain
ACME_EMAIL=replace-with-your-email

# The Vercel origin the browser loads the app from. A wrong value here shows up as every
# request failing CORS preflight, not as an obvious server error.
APP_CORS_ORIGINS=https://replace-with-your-app.vercel.app

# --- Services ---------------------------------------------------------------------
APP_ENVIRONMENT=production
APP_AUTH_MODE=supabase
APP_REPOSITORY_BACKEND=supabase

# Hosted Supabase project, NOT 127.0.0.1:54321. The service role key is server-only and
# bypasses row-level security -- it must never reach the web app or the browser.
APP_SUPABASE_URL=https://replace-with-project-ref.supabase.co
APP_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
APP_DATABASE_URL=

# Shared secret authenticating the API and worker to the LLM gateway and sandbox runner.
# Generate with: openssl rand -hex 32
# Required in production: with APP_ENVIRONMENT=production and this unset, every gateway
# and sandbox call answers 503 and course generation hangs at "planning" with no error.
APP_INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

APP_QUEUE_VISIBILITY_SECONDS=300
APP_QUEUE_POLL_SECONDS=2
APP_SANDBOX_TIMEOUT_SECONDS=20

# --- LLM gateway ------------------------------------------------------------------
APP_LLM_PROVIDER=openai
APP_OPENAI_API_KEY=replace-with-server-only-openai-api-key
APP_OPENAI_OUTLINE_MODEL=gpt-5.6-sol
APP_OPENAI_CONCEPTS_MODEL=gpt-5.6-luna
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_OPENAI_BUILDER_MODEL=gpt-5.6-luna
APP_OPENAI_REPAIR_MODEL=gpt-5.6-sol
APP_OPENAI_HELPER_MODEL=gpt-5.6-luna

# --- Set in the Supabase dashboard, not here ---------------------------------------
# Auth > URL Configuration : site_url and redirect URLs -> your Vercel domain
# Auth > SMTP Settings     : Resend credentials (magic link is the only sign-in path,
#                            and the built-in mailer's cap is a hard ceiling)
#
# --- Set in the Vercel dashboard, not here -----------------------------------------
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_API_URL is baked in at build time -- changing it needs a redeploy, not
# just an env edit.
