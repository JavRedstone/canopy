        <mxCell id="loop-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B35;fontColor=#FFFFFF;strokeColor=#CC4400;fontSize=16;fontStyle=1;arcSize=12;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;1 · Generate&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-weight:400;font-size:16px;&quot;&gt;GPT-5.6 &lt;b&gt;Luna&lt;/b&gt; (fast, high-volume tier), via the LLM Gateway, writes the lesson&#39;s starter workspace, hidden + visible tests, and reference solution.&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="430" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="loop-b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B35;fontColor=#FFFFFF;strokeColor=#CC4400;fontSize=16;fontStyle=1;arcSize=12;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;2 · Run for real&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-weight:400;font-size:16px;&quot;&gt;Sandbox Runner executes the starter, then the reference solution, against the real test suite. Nothing is trusted unverified.&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="820" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="loop-c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B35;fontColor=#FFFFFF;strokeColor=#CC4400;fontSize=16;fontStyle=1;arcSize=12;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;3 · Feed back the real failure&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-weight:400;font-size:16px;&quot;&gt;On a failing run, the actual pytest/doctest output goes back to GPT-5.6 — never a guess at what broke.&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="1210" y="1405" as="geometry" />
        </mxCell>
        <mxCell id="loop-d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6B35;fontColor=#FFFFFF;strokeColor=#CC4400;fontSize=16;fontStyle=1;arcSize=12;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;4 · Repair the exact file&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-weight:400;font-size:16px;&quot;&gt;GPT-5.6 &lt;b&gt;Sol&lt;/b&gt; (flagship reasoning tier — the last line of defense) patches only the starter or only the reference solution, whichever actually failed.&lt;/span&gt;" vertex="1">
