# Web
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Services
APP_ENVIRONMENT=development
APP_AUTH_MODE=supabase
APP_REPOSITORY_BACKEND=supabase
APP_SUPABASE_URL=http://127.0.0.1:54321
APP_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
APP_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
APP_CORS_ORIGINS=http://localhost:3000
APP_LLM_GATEWAY_URL=http://localhost:8010
APP_SANDBOX_RUNNER_URL=http://localhost:8020
APP_INTERNAL_SERVICE_TOKEN=replace-with-an-internal-service-token

# Custom SMTP for Supabase Auth. Magic link is the only sign-in method, so every
# login sends an email and the built-in provider's project-wide cap is a hard
# ceiling in production. Set these in the hosted dashboard (Auth > SMTP Settings);
# they are only read locally if you flip [auth.email.smtp] enabled = true in
# supabase/config.toml, which is off by default so local dev uses the mail
# catcher at http://localhost:54324 instead of sending real mail.
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=replace-with-server-only-smtp-api-key
SMTP_ADMIN_EMAIL=noreply@replace-with-your-domain

# LLM gateway -- APP_LLM_PROVIDER selects openai / azure / aws / aws_openai
APP_LLM_PROVIDER=openai
APP_OPENAI_API_KEY=replace-with-server-only-openai-api-key
APP_OPENAI_OUTLINE_MODEL=gpt-5.6-sol
APP_OPENAI_CONCEPTS_MODEL=gpt-5.6-luna
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_OPENAI_BUILDER_MODEL=gpt-5.6-luna
APP_OPENAI_REPAIR_MODEL=gpt-5.6-sol
APP_OPENAI_HELPER_MODEL=gpt-5.6-luna

# APP_LLM_PROVIDER=azure
APP_AZURE_OPENAI_ENDPOINT=https://replace-with-your-resource.openai.azure.com/
APP_AZURE_OPENAI_PLANNER_DEPLOYMENT=gpt-5.6-sol
APP_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
APP_AZURE_OPENAI_BUILDER_DEPLOYMENT=gpt-5.6-luna
APP_AZURE_OPENAI_REPAIR_DEPLOYMENT=gpt-5.6-sol
APP_AZURE_OPENAI_HELPER_DEPLOYMENT=gpt-5.6-luna

# APP_LLM_PROVIDER=aws -- Claude via Bedrock's Converse API
APP_AWS_REGION=us-east-1
APP_AWS_BEDROCK_PLANNER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
APP_AWS_BEDROCK_BUILDER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
APP_AWS_BEDROCK_REPAIR_MODEL=
APP_AWS_BEDROCK_HELPER_MODEL=
APP_AWS_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# APP_LLM_PROVIDER=aws_openai -- GPT via Bedrock's bedrock-mantle endpoint
APP_AWS_BEDROCK_API_KEY=replace-with-server-only-bedrock-api-key
APP_AWS_OPENAI_PLANNER_MODEL=openai.gpt-5.4
APP_AWS_OPENAI_BUILDER_MODEL=openai.gpt-5.4
APP_AWS_OPENAI_REPAIR_MODEL=
APP_AWS_OPENAI_HELPER_MODEL=
