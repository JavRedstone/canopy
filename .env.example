# Web
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# API, worker, and private-service routing
APP_ENVIRONMENT=development
APP_AUTH_MODE=supabase
APP_REPOSITORY_BACKEND=supabase
APP_SUPABASE_URL=http://127.0.0.1:54321
APP_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
APP_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
APP_CORS_ORIGINS=http://localhost:3000
APP_LLM_GATEWAY_URL=http://localhost:8010
APP_SANDBOX_RUNNER_URL=http://localhost:8020
# Required in non-development deployments; keep this secret server-to-server only.
APP_INTERNAL_SERVICE_TOKEN=replace-with-an-internal-service-token

# LLM gateway only. The API and worker must not receive these credentials.
# "openai", "azure", "aws" (Bedrock Converse: Claude/Nova), or "aws_openai"
# (GPT on Bedrock). APP_OPENAI_PROVIDER still works as a legacy alias.
APP_LLM_PROVIDER=openai
# Used for openai and azure providers.
APP_OPENAI_API_KEY=replace-with-server-only-openai-api-key
APP_OPENAI_PLANNER_MODEL=gpt-5.4-mini
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Lesson generation runs on every concept (Luna = newest-gen small tier). Repair only
# fires on labs that failed their first sandbox run, so it gets the flagship Sol tier.
# For azure/aws providers, repair reuses the builder model unless a *_REPAIR_* var is set.
APP_OPENAI_BUILDER_MODEL=gpt-5.6-luna
APP_OPENAI_REPAIR_MODEL=gpt-5.6-sol
# Short, high-frequency learner clarification requests use a separate model.
APP_OPENAI_HELPER_MODEL=gpt-5.6-luna

# Only used when APP_LLM_PROVIDER=azure
APP_AZURE_OPENAI_ENDPOINT=https://replace-with-your-resource.openai.azure.com/
APP_AZURE_OPENAI_PLANNER_DEPLOYMENT=replace-with-your-planner-deployment-name
APP_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=replace-with-your-embedding-deployment-name
APP_AZURE_OPENAI_BUILDER_DEPLOYMENT=replace-with-your-builder-deployment-name
# Optional; falls back to APP_AZURE_OPENAI_BUILDER_DEPLOYMENT when unset.
APP_AZURE_OPENAI_HELPER_DEPLOYMENT=

# Only used when APP_LLM_PROVIDER=aws (Bedrock Converse API).
# AWS credentials come from the standard chain: AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY (and AWS_SESSION_TOKEN), a shared profile, or a role.
APP_AWS_REGION=us-east-1
# Chat models must support Converse toolChoice (Anthropic Claude, Amazon Nova, Mistral Large).
APP_AWS_BEDROCK_PLANNER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
APP_AWS_BEDROCK_BUILDER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional; falls back to APP_AWS_BEDROCK_BUILDER_MODEL when unset.
APP_AWS_BEDROCK_HELPER_MODEL=
# Embeddings use InvokeModel with the Amazon Titan request shape.
APP_AWS_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Only used when APP_LLM_PROVIDER=aws_openai: OpenAI GPT models on Bedrock's
# bedrock-mantle Responses endpoint (available in us-east-1/us-east-2/us-west-2).
# Create a long-term Bedrock API key in the AWS console. Also set APP_AWS_REGION
# above, and AWS credentials for Titan embeddings (Mantle has no embeddings).
APP_AWS_BEDROCK_API_KEY=replace-with-server-only-bedrock-api-key
APP_AWS_OPENAI_PLANNER_MODEL=openai.gpt-5.6
APP_AWS_OPENAI_BUILDER_MODEL=openai.gpt-5.6
# Optional; falls back to APP_AWS_OPENAI_BUILDER_MODEL when unset.
APP_AWS_OPENAI_HELPER_MODEL=
