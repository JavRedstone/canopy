{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-source-learning.local/schemas/sandbox-runner.v1.json",
  "title": "Internal sandbox runner",
  "type": "object",
  "required": ["profile", "environment_id", "files"],
  "properties": {
    "profile": {
      "enum": ["content_validation", "learner_visible"]
    },
    "environment_id": {
      "const": "python-basic"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.py$" },
          "content": { "type": "string", "maxLength": 20000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
