{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-source-learning.local/schemas/course-plan.v1.json",
  "title": "Course plan",
  "type": "object",
  "required": ["course_title", "source_set_hash", "concepts", "modules"],
  "properties": {
    "course_title": { "type": "string", "minLength": 1 },
    "source_set_hash": { "type": "string", "minLength": 1 },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "summary_markdown", "citations"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "enum": ["conceptual", "coding"] },
          "summary_markdown": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "citations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "concept_ids"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "concept_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
